NODE_ENV=development
PORT=5000

# MySQL (5.6.5+)
DATABASE_URL=mysql://chat:chat@localhost:3306/chat
DB_POOL_MAX=10

# Firebase / Firestore
FIREBASE_PROJECT_ID=chatapp-8844b
# Path to a service-account JSON key (leave empty to use GOOGLE_APPLICATION_CREDENTIALS / ADC)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Set this to use the local Firestore emulator instead of a real project, e.g. localhost:8080
FIRESTORE_EMULATOR_HOST=
